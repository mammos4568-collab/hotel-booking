# คัดลอกเป็น .env.production แล้วตั้งค่าจริง — ห้าม commit .env.production
#   สุ่มค่าลับได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# รหัสผ่านฐานข้อมูล (ใช้ตัวอักษร/ตัวเลข เพราะถูกใส่ลงใน DATABASE_URL)
# ตั้งได้ครั้งเดียวตอนสร้างฐานข้อมูลครั้งแรก — เปลี่ยนทีหลังต้องเปลี่ยนในฐานข้อมูลด้วย
POSTGRES_PASSWORD=change-me-long-random-password

# กุญแจเซ็น JWT ของระบบล็อกอิน (อย่างน้อย 32 ตัวอักษร)
JWT_SECRET=change-me-at-least-32-random-characters

# URL ที่ผู้ใช้เปิดเว็บ (ไม่มี / ท้าย) และพอร์ตบนเครื่อง
#   ทดสอบบนเครื่องตัวเอง: http://localhost:8080
#   ขึ้น VPS ด้วย HTTPS (--profile https): https://<โดเมน> เช่น https://myhotel.duckdns.org — Caddy ใช้ค่านี้ขอใบรับรอง
PUBLIC_URL=http://localhost:8080
APP_PORT=8080

# อยู่หลัง reverse proxy ที่ทำ HTTPS ให้ (Caddy ใน --profile https / Nginx / Render ฯลฯ) ให้ตั้งเป็น 1
TRUST_PROXY=

# เข้าสู่ระบบด้วย Google / GitHub (ไม่บังคับ — เว้นว่าง = ปิดช่องทางนั้น)
# ลงทะเบียน callback กับแต่ละเจ้าเป็น <PUBLIC_URL>/api/auth/<google|github>/callback
#   เช่น https://hotel.example.com/api/auth/google/callback (ใช้งานจริงต้องเป็น https)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Opn Payments (TrueMoney / PromptPay ผ่าน gateway จริง) — ไม่บังคับ เว้นว่าง = ชำระเงินแบบจำลอง
#   key ทดสอบ (skey_test_...) ไม่มีการตัดเงินจริง · key จริง (skey_...) ต้องเปิดบัญชีร้านค้ากับ Opn ก่อน
#   ตั้ง webhook ใน dashboard ของ Opn เป็น <PUBLIC_URL>/api/bookings/gateway/webhook
OMISE_SECRET_KEY=
OMISE_PUBLIC_KEY=

# PromptPay เงินจริง (ไม่บังคับ) — หมายเลขพร้อมเพย์ที่รับเงิน: เบอร์มือถือ 10 หลัก (หรือเลขบัตรประชาชน 13 หลัก / e-Wallet 15 หลัก)
#   ตั้งแล้ว = ผู้ดูแลระบบ (admin) เห็นตัวเลือก "PromptPay เงินจริง" ตอนชำระเงิน → สแกนโอนจริง แล้ว admin กดยืนยันเองว่าเงินเข้า
#   ลูกค้าทั่วไปยังจ่ายแบบจำลองเหมือนเดิม · เว้นว่าง = ปิด · เบอร์จริงอยู่ในไฟล์นี้เท่านั้น ห้าม commit
PROMPTPAY_ID=
